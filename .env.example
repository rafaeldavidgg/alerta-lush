# StockAlert environment variables
# Copy this file to .env.local (for local development) and fill in real values.
# Never commit real secrets. The same names are used as GitHub Actions secrets
# and as Vercel environment variables.

# --- Telegram (required) ---
# Token from @BotFather, e.g. 123456789:AAExampleTokenValue
TELEGRAM_BOT_TOKEN=

# --- Shared storage: Upstash Redis (required unless STOCKALERT_STORE_BACKEND=memory) ---
# From the Upstash console, "REST API" section of your database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Local / dev options (optional) ---
# Backend for tracked products: "upstash" (default) or "memory" (local dev only).
STOCKALERT_STORE_BACKEND=upstash
