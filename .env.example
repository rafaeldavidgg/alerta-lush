# Alerta Lush environment variables
# Copy this file to .env.local (for local development) and fill in real values.
# Never commit real secrets. The same names are used as Vercel environment
# variables (the GitHub Actions fallback only needs the Telegram token and
# the Upstash REST credentials).

# --- Telegram (required) ---
# Token from @BotFather, e.g. 123456789:AAExampleTokenValue
# Used by the web app (to reply with your chat_id) and by the scheduled worker
# (to send restock alerts).
TELEGRAM_BOT_TOKEN=

# Secret that Telegram sends on webhook calls to /api/telegram/webhook.
# Generate any random string using A-Z a-z 0-9 _ - (1-256 chars) and pass the
# same value as `secret_token` in the setWebhook call. Required by the web app.
TELEGRAM_WEBHOOK_SECRET=

# --- Shared storage: Upstash Redis (required unless ALERTA_STORE_BACKEND=memory) ---
# From the Upstash console, "REST API" section of your database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scheduled monitoring via QStash (required for /api/cron/monitor) ---
# Bearer secret for manual calls: send `Authorization: Bearer <CRON_SECRET>`.
# Generate any random string (min 16 chars recommended) and set the same value
# as the QStash schedule's Authorization header and as Vercel env var.
CRON_SECRET=
# QStash signing keys for request-signature verification ("QStash → Settings →
# Request signing keys"). At least one scheduler credential is required:
# CRON_SECRET or QSTASH_CURRENT_SIGNING_KEY.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Token for creating/managing QStash schedules via API/CLI (Upstash console →
# QStash → "API token"). Only needed on the machine that creates the schedule,
# not in Vercel.
QSTASH_TOKEN=

# --- Local / dev options (optional) ---
# Backend for tracked products: "upstash" (default) or "memory" (local dev only).
# The legacy STOCKALERT_STORE_BACKEND name still works as a fallback.
ALERTA_STORE_BACKEND=upstash
